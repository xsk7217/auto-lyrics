<?xml version="1.0" encoding="utf-8"?>
<!-- Colors here are only "roles" for ui/ThemeStyler (bright = text, grey = secondary);
     the real colors come from the chosen palette and dark / light mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Lyrics"
                android:textColor="#E0E0FF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="車上的同步歌詞"
                android:textColor="#8888AA"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_theme_cycle"
            style="@style/AL.IconButton"
            android:src="@drawable/ic_theme"
            android:contentDescription="切換深色／淺色／跟隨系統" />
    </LinearLayout>

    <!-- Permission Status -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_permission"
        style="@style/AL.Chip"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="開啟通知存取權"
        android:visibility="gone" />

    <!-- Lyrics search (phone only) -->
    <Button
        android:id="@+id/btn_lyrics_search"
        style="@style/AL.Chip"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="4dp"
        android:gravity="start|center_vertical"
        android:paddingStart="16dp"
        android:text="搜尋歌詞 ／ 聽聲辨曲記錄"
        android:textSize="14sp"
        app:icon="@drawable/ic_search"
        app:iconSize="18dp"
        app:iconPadding="10dp"
        app:cornerRadius="23dp" />

    <!-- Now playing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:tag="glass">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <com.autolyrics.ui.HaloView
                android:id="@+id/halo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_album_art"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@drawable/bg_album_round"
                android:contentDescription="專輯封面" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E0FF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="還沒有播放中的歌曲" />

            <TextView
                android:id="@+id/tv_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:tag="sub"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_translation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:tag="hint"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|end">

        <Button
            android:id="@+id/btn_performance_mode"
            style="@style/AL.Chip"
            android:text="全螢幕歌詞" />

        <ImageButton
            android:id="@+id/btn_switch_source"
            style="@style/AL.IconButton"
            android:src="@drawable/ic_refresh"
            android:contentDescription="換來源重抓歌詞" />

        <ImageButton
            android:id="@+id/btn_settings_toggle"
            style="@style/AL.IconButton"
            android:src="@drawable/ic_settings"
            android:contentDescription="顯示設定" />
    </LinearLayout>

    <!-- Settings panel (collapsed by default) -->
    <ScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_font_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:tag="glass">

            <TextView style="@style/AL.Label" android:text="外觀" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_mode_dark" style="@style/AL.Chip" android:text="深色" />
                <Button android:id="@+id/btn_mode_light" style="@style/AL.Chip" android:text="淺色" />
                <Button android:id="@+id/btn_mode_system" style="@style/AL.Chip" android:text="跟隨系統" />
            </LinearLayout>

            <TextView style="@style/AL.Label" android:text="配色" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_pal_indigo" style="@style/AL.Chip" android:text="靛紫" />
                <Button android:id="@+id/btn_pal_ocean" style="@style/AL.Chip" android:text="深海" />
                <Button android:id="@+id/btn_pal_midnight" style="@style/AL.Chip" android:text="夜空" />
                <Button android:id="@+id/btn_pal_graphite" style="@style/AL.Chip" android:text="石墨" />
            </LinearLayout>

            <TextView style="@style/AL.Label" android:text="歌詞字體大小" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Button android:id="@+id/btn_font_size_minus" style="@style/AL.Chip" android:text="A−" />
                <TextView
                    android:id="@+id/tv_font_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:gravity="center"
                    android:text="16sp"
                    android:textColor="#CCCCDD"
                    android:textSize="13sp" />
                <Button android:id="@+id/btn_font_size_plus" style="@style/AL.Chip" android:text="A+" />
            </LinearLayout>

            <TextView style="@style/AL.Label" android:text="歌詞字型" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_font_sans" style="@style/AL.Chip" android:text="黑體" android:fontFamily="sans-serif" />
                <Button android:id="@+id/btn_font_serif" style="@style/AL.Chip" android:text="襯線" android:fontFamily="serif" />
                <Button android:id="@+id/btn_font_mono" style="@style/AL.Chip" android:text="等寬" android:fontFamily="monospace" />
                <Button android:id="@+id/btn_font_cursive" style="@style/AL.Chip" android:text="手寫" android:fontFamily="cursive" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#2A2A3A" />

            <TextView style="@style/AL.Label" android:text="Android Auto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="車機逐字卡拉 OK"
                    android:textColor="#CCCCDD"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_aa_karaoke"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="翻譯歌詞"
                    android:textColor="#CCCCDD"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_translation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_translation_target"
                style="@style/AL.Chip"
                android:layout_width="match_parent"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_lyrics_sources"
                style="@style/AL.Chip"
                android:layout_width="match_parent"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="8dp"
                android:text="歌詞來源與進階設定 ›" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="車機延遲"
                    android:textColor="#8888AA"
                    android:textSize="12sp" />
                <Button android:id="@+id/btn_aa_delay_minus" style="@style/AL.Chip" android:text="−" />
                <TextView
                    android:id="@+id/tv_aa_delay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:gravity="center"
                    android:text="0ms"
                    android:textColor="#CCCCDD"
                    android:textSize="13sp" />
                <Button android:id="@+id/btn_aa_delay_plus" style="@style/AL.Chip" android:text="+" />
                <Button android:id="@+id/btn_aa_delay_reset" style="@style/AL.Chip" android:text="重設" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#2A2A3A" />

            <TextView style="@style/AL.Label" android:text="手機歌詞延遲" />

            <LinearLayout
                android:id="@+id/layout_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button android:id="@+id/btn_delay_minus" style="@style/AL.Chip" android:text="−" />
                    <TextView
                        android:id="@+id/tv_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="100dp"
                        android:gravity="center"
                        android:text="0ms"
                        android:textColor="#CCCCDD"
                        android:textSize="13sp" />
                    <Button android:id="@+id/btn_delay_plus" style="@style/AL.Chip" android:text="+" />
                    <Button android:id="@+id/btn_delay_reset" style="@style/AL.Chip" android:text="重設" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btn_quick_minus_1s" style="@style/AL.Chip" android:text="−1s" />
                    <Button android:id="@+id/btn_quick_minus_half" style="@style/AL.Chip" android:text="−0.5s" />
                    <Button android:id="@+id/btn_quick_plus_half" style="@style/AL.Chip" android:text="+0.5s" />
                    <Button android:id="@+id/btn_quick_plus_1s" style="@style/AL.Chip" android:text="+1s" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_tap_sync"
                    style="@style/AL.Chip"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="0dp"
                    android:layout_marginTop="6dp"
                    android:text="Tap to Sync" />

                <TextView
                    android:id="@+id/tv_sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:textColor="#CCCCDD"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <!-- Lyrics -->
    <FrameLayout
        android:id="@+id/lyrics_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:tag="glass">

        <ScrollView
            android:id="@+id/scroll_lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="#CCCCDD"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:gravity="center_horizontal"
                android:text="Play a song to see lyrics here.\n\nLyrics will also appear on Android Auto." />
        </ScrollView>

        <Button
            android:id="@+id/btn_jump_to_current"
            style="@style/AL.Chip"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="0dp"
            android:tag="chip-on"
            android:text="↓ 回到目前歌詞"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
